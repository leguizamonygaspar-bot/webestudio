# Encabezados de Cloudflare Pages (seguridad y caché)
# PENDIENTE: el día de la publicación (18/12) borrar la línea X-Robots-Tag para que Google indexe.

/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://formspree.io https://cloudflareinsights.com; form-action 'self' https://formspree.io; frame-src https://www.openstreetmap.org; base-uri 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=604800
